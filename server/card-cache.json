      "read-replication",
      "connection-pooling"
    ],
    "flows": [
      {
        "from": "Mobile App",
        "to": "API Server (Node.js)",
        "verb": "requests",
        "kind": "sync"
      },
      {
        "from": "API Server (Node.js)",
        "to": "Postgres (Primary)",
        "verb": "queries",
        "kind": "sync"
      },
      {
        "from": "Postgres (Primary)",
        "to": "API Server (Node.js)",
        "verb": "returns",
        "kind": "sync"
      },
      {
        "from": "API Server (Node.js)",
        "to": "Mobile App",
        "verb": "responds",
        "kind": "sync"
      },
      {
        "from": "Inventory Service",
        "to": "Postgres (Primary)",
        "verb": "writes price and stock changes",
        "kind": "sync"
      },
