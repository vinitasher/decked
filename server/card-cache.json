  "queues:3": {
    "id": "queues-gen-1785292786255",
    "topic": "queues",
    "difficulty": 5,
    "scenario": "You are designing the booking engine for a concert ticketing platform. During on-sale events, 500,000 concurrent users submit 50,000 booking requests per second for 20,000 total seats. Each request must be processed in order per seat category and confirmed within 500 ms. Double-bookings are unacceptable. The team must choose a queuing architecture that balances ordering guarantees, throughput, and operational complexity.",
    "nodes": [
      "End User",
      "Web Client (React)",
      "Nginx Rate-Limiting Reverse Proxy",
      "Booking API Service (Go)",
      "Kafka Cluster (3 brokers)",
      "Postgres with optimistic locking",
      "Redis for idempotency tokens"
    ],
    "options": [
      {
        "id": "A",
        "label": "Direct Postgres INSERT with SERIALIZABLE isolation; each booking request acquires row-level locks on seat and event rows.",
        "prerequisiteTopics": [
          "transaction-isolation",
          "row-locking",
          "deadlocks",
          "connection-pooling"
        ],
        "flows": [
          {
            "from": "Web Client (React)",
            "to": "Nginx Rate-Limiting Reverse Proxy",
            "verb": "requests",
            "kind": "sync"
          },
          {
            "from": "Nginx Rate-Limiting Reverse Proxy",
            "to": "Booking API Service (Go)",
            "verb": "forwards",
            "kind": "sync"
          },
          {
            "from": "Booking API Service (Go)",
            "to": "Postgres with optimistic locking",
            "verb": "inserts with SERIALIZABLE isolation",
            "kind": "sync"
          },
          {
            "from": "Postgres with optimistic locking",
            "to": "Booking API Service (Go)",
            "verb": "returns row with acquired lock",
            "kind": "sync"
          },
          {
            "from": "Booking API Service (Go)",
            "to": "Web Client (React)",
            "verb": "confirms",
            "kind": "sync"
          }
        ]
      },
      {
        "id": "B",
        "label": "Kafka ingestion with one partition per seat category; consumers process sequentially per partition and write to Postgres with optimistic locking.",
        "prerequisiteTopics": [
          "message-partitioning",
          "message-ordering",
          "optimistic-concurrency"
        ],
        "flows": [
          {
            "from": "Web Client (React)",
            "to": "Nginx Rate-Limiting Reverse Proxy",
            "verb": "requests",
            "kind": "sync"
          },
          {
            "from": "Nginx Rate-Limiting Reverse Proxy",
            "to": "Booking API Service (Go)",
            "verb": "forwards",
            "kind": "sync"
          },
          {
            "from": "Booking API Service (Go)",
            "to": "Redis for idempotency tokens",
            "verb": "checks idempotency token",
            "kind": "sync"
          },
          {
            "from": "Booking API Service (Go)",
            "to": "Kafka Cluster (3 brokers)",
            "verb": "publishes to category partition",
            "kind": "async"
          },
          {
            "from": "Kafka Cluster (3 brokers)",
            "to": "Booking API Service (Go)",
            "verb": "delivers sequentially per partition",
            "kind": "async"
          },
          {
            "from": "Booking API Service (Go)",
            "to": "Postgres with optimistic locking",
            "verb": "writes with optimistic locking",
            "kind": "sync"
          },
          {
            "from": "Postgres with optimistic locking",
            "to": "Booking API Service (Go)",
            "verb": "returns updated row",
            "kind": "sync"
          },
          {
            "from": "Booking API Service (Go)",
            "to": "Web Client (React)",
            "verb": "confirms",
            "kind": "callback"
          }
        ]
      },
      {
        "id": "C",
        "label": "RabbitMQ competing consumers pulling from a single queue; each consumer reads seat availability from Redis, then writes to Postgres.",
        "prerequisiteTopics": [
          "competing-consumers",
          "cache-coherence",
          "read-modify-write-races"
        ],
        "flows": [
          {
            "from": "Nginx Rate-Limiting Reverse Proxy",
            "to": "Booking API Service (Go)",
            "verb": "forwards",
            "kind": "sync"
          },
          {
            "from": "Redis for idempotency tokens",
            "to": "Booking API Service (Go)",
            "verb": "reads seat availability",
            "kind": "sync"
          },
          {
            "from": "Booking API Service (Go)",
            "to": "Postgres with optimistic locking",
            "verb": "writes",
            "kind": "sync"
          },
          {
            "from": "Postgres with optimistic locking",
            "to": "Booking API Service (Go)",
            "verb": "returns seat claim result",
            "kind": "sync"
          },
          {
            "from": "Booking API Service (Go)",
            "to": "Web Client (React)",
            "verb": "confirms",
            "kind": "sync"
          }
        ]
      },
      {
        "id": "D",
        "label": "Amazon SQS FIFO queues (one per seat category) feeding AWS Lambda; consumers write to DynamoDB with conditional write for seat claims.",
        "prerequisiteTopics": [
          "fifo-queues",
          "conditional-writes",
          "serverless-cold-starts"
        ]
      }
    ],
    "correct": "B",
    "explanation": "Option A fails for scalability: 50,000 RPS with SERIALIZABLE isolation would exhaust Postgres max_connections (typically 100-500) and cause catastrophic deadlock retries, capping throughput below 5,000 RPS. Option C fails for consistency: competing consumers read seat availability from Redis simultaneously, both see a seat as free and proceed to book it — a classic read-then-write race condition that produces double-bookings. Option D fails for latency and complexity: SQS FIFO queues throttle at 3,000 TPS per queue, requiring 17+ queues and a custom sharding layer, while Lambda cold starts on burst add 200-500ms that push past the 500ms confirmation budget. Option B is correct because Kafka partitions guarantee strict ordering per seat category, handle 50,000 RPS on three brokers with ease, and consumers using optimistic locking (version-check on UPDATE) prevent double-bookings without expensive coordination.",
    "prerequisiteTopics": [
